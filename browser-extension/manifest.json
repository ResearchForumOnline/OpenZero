{
  "manifest_version": 3,
  "name": "OpenZero Tab Pilot",
  "version": "0.1.0",
  "description": "Explicitly grant one Brave tab to OpenZero for inspected, visible, policy-controlled browser work.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "OpenZero Tab Pilot"
  },
  "options_page": "src/options.html"
}
